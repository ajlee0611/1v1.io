{
  "name": "1v1-io",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=@1v1/shared",
    "dev:client": "npm run dev --workspace=@1v1/client",
    "dev:server": "npm run dev --workspace=@1v1/server",
    "dev": "npm run dev:server & npm run dev:client",
    "build": "npm run build:shared && npm run build --workspaces"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/rapier": "^2.2.0",
    "@types/three": "^0.186.0",
    "lucide-react": "^1.55.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3"
  }
}
